# ==========================================================================
# meyerdenker.de – Rewrite-/Redirect-Regeln (Apache, Strato)
# WICHTIG: Strato terminiert TLS an einem vorgelagerten Proxy. Apache sieht
# die Anfrage intern als HTTP, daher darf NICHT %{HTTPS} geprüft werden
# (sonst Redirect-Schleife). Stattdessen den Header X-Forwarded-Proto nutzen,
# und nur umleiten, wenn dieser gesetzt UND nicht "https" ist.
# ==========================================================================
RewriteEngine On

# 1) HTTP -> HTTPS (nur wenn der Proxy-Header vorhanden und != https ist)
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP:X-Forwarded-Proto} .+
RewriteRule ^ https://meyerdenker.de%{REQUEST_URI} [R=301,L]

# 2) www -> non-www (kanonische Host-Variante)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---- Kleinere Performance-/Caching-Hinweise -------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
</IfModule>
