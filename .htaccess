# ==========================================================================
# meyerdenker.de – Rewrite-/Redirect-Regeln (Apache, Strato)
# HTTPS erzwingen und auf die kanonische Domain ohne "www" umleiten.
# ==========================================================================
RewriteEngine On

# 1) HTTP -> HTTPS
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://meyerdenker.de%{REQUEST_URI} [R=301,L]

# 2) www -> non-www (kanonische Host-Variante)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---- Optional: einfache Fehlerseite (nutzt die Startseite) ----------------
# ErrorDocument 404 /index.html

# ---- Kleinere Performance-/Caching-Hinweise -------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
</IfModule>
